<Window x:Class="WizLightWidget.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320" Height="180" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="False"
        FontFamily="Segoe UI">
    <Border Background="#121212" CornerRadius="14" BorderBrush="#333333" BorderThickness="1">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
            <TextBlock Text="Luces WiZ" FontSize="18" FontWeight="SemiBold" Foreground="#F5F5F5"
                       HorizontalAlignment="Center" Margin="0,0,0,18"/>
            <ProgressBar x:Name="ProgressIndicator" IsIndeterminate="True" Width="220" Height="4"
                         Margin="0,0,0,10" Background="#3A3A3A" BorderThickness="0" Foreground="#FFC857"/>
            <TextBlock x:Name="StatusTextBlock" Text="Iniciando..." FontSize="12" Foreground="#AAAAAA"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Border>
</Window>
