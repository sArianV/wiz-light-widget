<Window x:Class="WizLightWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Luces WiZ" Height="580" Width="400" MinWidth="360" MinHeight="420"
        Background="#121212" Foreground="#F5F5F5"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC857"/>
        <SolidColorBrush x:Key="CardBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#3A3A3A"/>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="12" Background="#3A3A3A">
                            <Grid>
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X" To="18" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                             Storyboard.TargetProperty="Background.Color" To="#FFC857" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                             Storyboard.TargetProperty="Background.Color" To="#3A3A3A" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="{StaticResource TrackBrush}" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" Background="{StaticResource AccentBrush}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteStarStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <TextBlock x:Name="Star" Text="&#9733;" FontSize="16" Foreground="#4A4A4A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Star" Property="Foreground" Value="#8A8A8A"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Star" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconGhostButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="#00000000" StrokeThickness="1"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchMoreButtonStyle" TargetType="Button" BasedOn="{StaticResource SwatchButtonStyle}">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12" Foreground="#CCCCCC"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="16,16,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Luces WiZ" FontSize="18" FontWeight="SemiBold"/>
            </StackPanel>
            <Button x:Name="SettingsButton" Grid.Column="1" Content="&#xE713;" FontSize="15"
                    FontFamily="Segoe MDL2 Assets"
                    Style="{StaticResource IconGhostButtonStyle}" Click="SettingsButton_Click"
                    ToolTip="Configuración" Width="30" Height="30" Margin="0,0,8,0"/>
            <Button x:Name="DiscoverButton" Grid.Column="2" Content="Buscar"
                    Style="{StaticResource AccentButtonStyle}" Click="DiscoverButton_Click"/>

            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#242424" CornerRadius="10" Padding="14"
                        BorderBrush="#3A3A3A" BorderThickness="1">
                    <StackPanel MinWidth="200">
                        <TextBlock Text="Configuración" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#F5F5F5" Margin="0,0,0,10"/>
                        <CheckBox x:Name="StartWithWindowsCheckBox" Content="Iniciar con Windows"
                                  Foreground="#F5F5F5" Click="StartWithWindowsCheckBox_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,0">
            <ItemsControl x:Name="BulbList" Margin="8,0,8,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ToggleButton Grid.Column="0" IsChecked="{Binding IsFavorite}"
                                                  Style="{StaticResource FavoriteStarStyle}"
                                                  Click="FavoriteToggle_Click"
                                                  ToolTip="Marcar como favorito (controlado desde la barra de tareas)"/>
                                    <TextBox x:Name="NameTextBox" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent" BorderThickness="0" Foreground="#F5F5F5"
                                             FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                             Padding="0" Margin="4,0,0,0" LostFocus="NameTextBox_LostFocus"/>
                                    <Button Grid.Column="2" Content="&#9998;" Style="{StaticResource IconGhostButtonStyle}"
                                            Click="EditName_Click" ToolTip="Renombrar"/>
                                    <ToggleButton Grid.Column="3" IsChecked="{Binding IsOn}"
                                                  Style="{StaticResource SwitchToggleStyle}"
                                                  Click="PowerToggle_Click"/>
                                </Grid>
                                <TextBlock Text="{Binding Ip}" FontSize="11" Opacity="0.45" Margin="0,2,0,12"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Grid.Column="0" Minimum="10" Maximum="100" Value="{Binding Brightness}"
                                            Margin="0,0,8,0" VerticalAlignment="Center"
                                            Style="{StaticResource AccentSliderStyle}"
                                            ValueChanged="BrightnessSlider_ValueChanged"
                                            PreviewMouseLeftButtonDown="BrightnessSlider_PreviewMouseLeftButtonDown"
                                            PreviewMouseMove="BrightnessSlider_PreviewMouseMove"
                                            PreviewMouseLeftButtonUp="BrightnessSlider_PreviewMouseLeftButtonUp"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat={}{0:0}%}"
                                               Width="38" Opacity="0.7" FontSize="12" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal">
                                    <Button Tag="TEMP:2700" Background="#FFD9A6" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click" ToolTip="Blanco cálido (brillo máximo real)"/>
                                    <Button Tag="TEMP:6500" Background="#EAF4FF" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click" ToolTip="Blanco frío (brillo máximo real)"/>
                                    <Button Tag="#FF6B6B" Background="#FF6B6B" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                    <Button Tag="#FFA500" Background="#FFA500" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                    <Button Tag="#FFD93D" Background="#FFD93D" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                    <Button Tag="#6BCB77" Background="#6BCB77" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                    <Button Tag="#4D96FF" Background="#4D96FF" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                    <Button Tag="#9B5DE5" Background="#9B5DE5" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                    <Button x:Name="MoreColorsButton" Content="&#8230;" Style="{StaticResource SwatchMoreButtonStyle}" Click="CustomColor_Click"/>

                                    <Popup x:Name="ColorPickerPopup" PlacementTarget="{Binding ElementName=MoreColorsButton}"
                                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="#242424" CornerRadius="12" Padding="12"
                                                BorderBrush="#3A3A3A" BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="Arriba = más brillo (mezcla con blanco) · Abajo = color más puro"
                                                           FontSize="10" Opacity="0.6" Width="240" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                <Canvas x:Name="ColorPickerCanvas" Width="240" Height="140" ClipToBounds="True"
                                                        Background="Transparent" Cursor="Cross"
                                                        MouseLeftButtonDown="ColorPickerCanvas_MouseLeftButtonDown"
                                                        MouseMove="ColorPickerCanvas_MouseMove"
                                                        MouseLeftButtonUp="ColorPickerCanvas_MouseLeftButtonUp">
                                                    <Rectangle Width="240" Height="140" RadiusX="8" RadiusY="8">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#FF0000" Offset="0"/>
                                                                <GradientStop Color="#FFFF00" Offset="0.17"/>
                                                                <GradientStop Color="#00FF00" Offset="0.33"/>
                                                                <GradientStop Color="#00FFFF" Offset="0.5"/>
                                                                <GradientStop Color="#0000FF" Offset="0.67"/>
                                                                <GradientStop Color="#FF00FF" Offset="0.83"/>
                                                                <GradientStop Color="#FF0000" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <Rectangle Width="240" Height="140" RadiusX="8" RadiusY="8" IsHitTestVisible="False">
                                                        <Rectangle.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                                <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Rectangle.Fill>
                                                    </Rectangle>
                                                    <Ellipse x:Name="ColorPickerThumb" Width="18" Height="18"
                                                             Stroke="White" StrokeThickness="2" Fill="Transparent"
                                                             IsHitTestVisible="False" Canvas.Left="0" Canvas.Top="0"/>
                                                </Canvas>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Opacity="0.55" FontSize="12"
                       Text="Buscando bombillos en tu red..." TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionText" Grid.Column="1" Opacity="0.35" FontSize="11"
                       VerticalAlignment="Bottom" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
