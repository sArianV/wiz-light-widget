<Window x:Class="WizLightWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:WizLightWidget.Converters"
        Title="Luces WiZ" Height="580" Width="400" MinWidth="360" MinHeight="420"
        WindowStyle="None" ResizeMode="CanMinimize"
        Background="#1E1E20" Foreground="#F5F5F7"
        FontFamily="Segoe UI Variable Text, Segoe UI" WindowStartupLocation="CenterScreen"
        StateChanged="MainWindow_StateChanged">
    <Window.Resources>
        <converters:SwatchActiveConverter x:Key="SwatchActiveConverter"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#FFC857"/>
        <SolidColorBrush x:Key="CardBrush" Color="#2C2C2E"/>
        <SolidColorBrush x:Key="TrackBrush" Color="#3A3A3C"/>

        <Style x:Key="WindowControlButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="#8A8A8E"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3C"/>
                                <Setter Property="Foreground" Value="#F5F5F7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WindowCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource WindowControlButtonStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#E81123"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwitchToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="12" Background="#3A3A3A">
                            <Grid>
                                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="White"
                                         HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform x:Name="ThumbTransform" X="0"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X" To="18" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                             Storyboard.TargetProperty="Background.Color" To="#FFC857" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ThumbTransform"
                                                             Storyboard.TargetProperty="X" To="0" Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="Track"
                                                             Storyboard.TargetProperty="Background.Color" To="#3A3A3A" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="20"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="{StaticResource TrackBrush}" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Height="4" Background="{StaticResource AccentBrush}" CornerRadius="2"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Background="Transparent" BorderThickness="0" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate>
                                                <Ellipse Fill="White"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FavoriteStarStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid Background="Transparent">
                            <TextBlock x:Name="Star" Text="&#9733;" FontSize="16" Foreground="#4A4A4A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Star" Property="Foreground" Value="#8A8A8A"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Star" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TextLinkButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FFC857"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="0,4">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#FFD98C"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8A8A8A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconGhostButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <Ellipse Stroke="White" StrokeThickness="2" Margin="-3">
                                <Ellipse.Visibility>
                                    <MultiBinding Converter="{StaticResource SwatchActiveConverter}">
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Background"/>
                                        <Binding Path="Color"/>
                                    </MultiBinding>
                                </Ellipse.Visibility>
                            </Ellipse>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón "fantasma" reutilizable: ícono (y opcionalmente texto) que pasa de gris a
             amarillo (AccentBrush) en hover, sin fondo. El contenido (Content) define qué
             se muestra: un solo glyph, o un StackPanel con ícono+texto; y como ninguno
             de esos elementos fija su propio Foreground, heredan el de este Button, así que
             el trigger de hover solo necesita tocar una propiedad para que todo cambie junto. -->
        <Style x:Key="HoverAccentButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#8A8A8A"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <Ellipse x:Name="Ring" Stroke="White" StrokeThickness="2" Margin="-3" Opacity="0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Opacity" Value="0.3"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SceneSelectorButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="#2C2C2E"/>
            <Setter Property="Foreground" Value="#F5F5F5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="10" Padding="12,0">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#3A3A3C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SwatchMoreButtonStyle" TargetType="Button" BasedOn="{StaticResource SwatchButtonStyle}">
            <Setter Property="Background" Value="#2A2A2A"/>
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <TextBlock Text="{TemplateBinding Content}" FontSize="12" Foreground="#CCCCCC"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Height="36" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Luces WiZ" FontSize="12" FontWeight="SemiBold"
                       Foreground="#98989D" VerticalAlignment="Center" Margin="16,0,0,0"
                       IsHitTestVisible="False"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                <Button x:Name="MinimizeButton" Style="{StaticResource WindowControlButtonStyle}"
                        Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimizar"/>
                <Button x:Name="MaximizeButton" Style="{StaticResource WindowControlButtonStyle}"
                        Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Maximizar"/>
                <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButtonStyle}"
                        Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Cerrar"/>
            </StackPanel>
        </Grid>

        <Button x:Name="ScenesButton" Grid.Row="1" Margin="16,10,16,0"
                Style="{StaticResource SceneSelectorButtonStyle}" Click="ScenesButton_Click"
                ToolTip="Guardar el estado actual de todos los focos como escena, o aplicar una guardada">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SceneSelectorLabel" Grid.Column="0" Text="Escenas"
                           VerticalAlignment="Center" FontSize="13"/>
                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                           FontSize="10" Opacity="0.5" VerticalAlignment="Center"/>
            </Grid>
        </Button>

        <Popup x:Name="ScenesPopup" Grid.Row="1" PlacementTarget="{Binding ElementName=ScenesButton}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#242424" CornerRadius="10" Padding="14"
                    BorderBrush="#3A3A3A" BorderThickness="1">
                <StackPanel MinWidth="260" MaxWidth="300">
                    <TextBlock Text="Escenas" FontSize="13" FontWeight="SemiBold"
                               Foreground="#F5F5F5" Margin="0,0,0,10"/>
                    <TextBlock x:Name="NoScenesText" Text="No hay escenas guardadas todavía."
                               FontSize="12" Opacity="0.5" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <ItemsControl x:Name="ScenesList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="{Binding Name}" Tag="{Binding Name}"
                                            Style="{StaticResource TextLinkButtonStyle}"
                                            HorizontalContentAlignment="Left" Click="ApplySceneButton_Click"/>
                                    <Button Grid.Column="1" Content="&#10005;" Tag="{Binding Name}"
                                            Style="{StaticResource IconGhostButtonStyle}" Width="22" Height="22" FontSize="10"
                                            Click="DeleteSceneButton_Click" ToolTip="Eliminar escena"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Height="1" Background="#3A3A3A" Margin="0,4,0,10"/>
                    <StackPanel x:Name="NewSceneNamePanel" Visibility="Collapsed" Margin="0,0,0,4">
                        <TextBox x:Name="NewSceneNameBox" Background="#1E1E20" BorderBrush="#3A3A3A" BorderThickness="1"
                                 Foreground="#F5F5F5" Padding="6,5" Margin="0,0,0,8" KeyDown="NewSceneNameBox_KeyDown"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Guardar" Style="{StaticResource AccentButtonStyle}"
                                    Click="SaveSceneConfirm_Click" Margin="0,0,8,0"/>
                            <Button Content="Cancelar" Style="{StaticResource TextLinkButtonStyle}" Click="SaveSceneCancel_Click"/>
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="NewSceneButton" Content="+ Guardar escena actual"
                            Style="{StaticResource TextLinkButtonStyle}" Click="NewSceneButton_Click"/>
                </StackPanel>
            </Border>
        </Popup>

        <Grid Grid.Row="2" Margin="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="RhythmButton" Grid.Column="1"
                    Style="{StaticResource HoverAccentButtonStyle}" Click="RhythmButton_Click"
                    ToolTip="Modo rítmico: elegí arcoíris o colores fijos para pulsar con la música">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#9835;" FontSize="19" VerticalAlignment="Center"/>
                    <TextBlock Text="DJ" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="5,0,0,0"/>
                </StackPanel>
            </Button>
            <Button x:Name="SettingsButton" Grid.Column="2" Content="&#xE713;" FontSize="15"
                    FontFamily="Segoe MDL2 Assets"
                    Style="{StaticResource IconGhostButtonStyle}" Click="SettingsButton_Click"
                    ToolTip="Configuración" Width="30" Height="30" Margin="0,0,8,0"/>
            <Button x:Name="DiscoverButton" Grid.Column="0" HorizontalAlignment="Left" Content="Escanear dispositivos"
                    Style="{StaticResource TextLinkButtonStyle}" Click="DiscoverButton_Click"/>

            <Popup x:Name="RhythmPopup" PlacementTarget="{Binding ElementName=RhythmButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#242424" CornerRadius="10" Padding="14"
                        BorderBrush="#3A3A3A" BorderThickness="1">
                    <StackPanel MinWidth="230">
                        <TextBlock Text="Modo rítmico" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#F5F5F5" Margin="0,0,0,10"/>
                        <RadioButton x:Name="RainbowModeRadio" GroupName="RhythmMode" Tag="Rainbow"
                                     Content="🌈 Arcoíris (todos los tonos)" Foreground="#F5F5F5"
                                     Margin="0,0,0,10" Click="RhythmModeRadio_Click"/>
                        <RadioButton x:Name="RainbowRandomModeRadio" GroupName="RhythmMode" Tag="RainbowRandom"
                                     Content="🎲 Arcoíris aleatorio" Foreground="#F5F5F5"
                                     Margin="0,0,0,10" Click="RhythmModeRadio_Click"/>
                        <RadioButton x:Name="PaletteSunsetRadio" GroupName="RhythmMode" Tag="PaletteSunset"
                                     Margin="0,0,0,10" Click="RhythmModeRadio_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" Fill="#FF0066" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#00C853" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#FFD700" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#2962FF" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#FF3D00" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#00E5FF"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PaletteOceanRadio" GroupName="RhythmMode" Tag="PaletteOcean"
                                     Margin="0,0,0,10" Click="RhythmModeRadio_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" Fill="#00FFFF" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#FF3D00" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#651FFF" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#FFEA00" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#2962FF" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#FF0066"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PaletteNeonRadio" GroupName="RhythmMode" Tag="PaletteNeon"
                                     Margin="0,0,0,10" Click="RhythmModeRadio_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" Fill="#FF00C8" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#39FF14" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#7B2FFF" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#FFEA00" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#00E5FF" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#FF3D00"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="PaletteFireRadio" GroupName="RhythmMode" Tag="PaletteFire"
                                     Margin="0,0,0,10" Click="RhythmModeRadio_Click">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" Fill="#FF0000" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#00E5FF" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#FF6D00" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#2962FF" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#FFD700" Margin="0,0,4,0"/>
                                <Ellipse Width="14" Height="14" Fill="#651FFF"/>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="FixedModeRadio" GroupName="RhythmMode" Tag="FixedList"
                                     Content="🎨 Colores fijos" Foreground="#F5F5F5"
                                     Margin="0,0,0,6" Click="RhythmModeRadio_Click"/>
                        <WrapPanel x:Name="FixedColorsPanel" Margin="20,0,0,10">
                            <ToggleButton Tag="#FFD9A6" Background="#FFD9A6" IsChecked="True"
                                          Style="{StaticResource SwatchToggleStyle}" Click="FixedColorToggle_Click"
                                          ToolTip="Blanco cálido"/>
                            <ToggleButton Tag="#EAF4FF" Background="#EAF4FF" IsChecked="True"
                                          Style="{StaticResource SwatchToggleStyle}" Click="FixedColorToggle_Click"
                                          ToolTip="Blanco frío"/>
                            <ToggleButton Tag="#FF6B6B" Background="#FF6B6B" IsChecked="True"
                                          Style="{StaticResource SwatchToggleStyle}" Click="FixedColorToggle_Click"/>
                            <ToggleButton Tag="#FFA500" Background="#FFA500" IsChecked="True"
                                          Style="{StaticResource SwatchToggleStyle}" Click="FixedColorToggle_Click"/>
                            <ToggleButton Tag="#FFD93D" Background="#FFD93D" IsChecked="True"
                                          Style="{StaticResource SwatchToggleStyle}" Click="FixedColorToggle_Click"/>
                            <ToggleButton Tag="#6BCB77" Background="#6BCB77" IsChecked="True"
                                          Style="{StaticResource SwatchToggleStyle}" Click="FixedColorToggle_Click"/>
                            <ToggleButton Tag="#4D96FF" Background="#4D96FF" IsChecked="True"
                                          Style="{StaticResource SwatchToggleStyle}" Click="FixedColorToggle_Click"/>
                            <ToggleButton Tag="#9B5DE5" Background="#9B5DE5" IsChecked="True"
                                          Style="{StaticResource SwatchToggleStyle}" Click="FixedColorToggle_Click"/>
                        </WrapPanel>
                        <Border Height="1" Background="#3A3A3A" Margin="0,4,0,10"/>
                        <Button x:Name="RhythmStopButton" Content="Detener modo rítmico"
                                Style="{StaticResource TextLinkButtonStyle}" Click="RhythmStopButton_Click"/>
                    </StackPanel>
                </Border>
            </Popup>

            <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="#242424" CornerRadius="10" Padding="14"
                        BorderBrush="#3A3A3A" BorderThickness="1">
                    <StackPanel MinWidth="200">
                        <TextBlock Text="Configuración" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#F5F5F5" Margin="0,0,0,10"/>
                        <CheckBox x:Name="StartWithWindowsCheckBox" Content="Iniciar con Windows"
                                  Foreground="#F5F5F5" Click="StartWithWindowsCheckBox_Click"/>
                        <Border Height="1" Background="#3A3A3A" Margin="0,12,0,10"/>
                        <Button x:Name="CheckForUpdatesButton" Content="Buscar actualizaciones"
                                Style="{StaticResource TextLinkButtonStyle}" Click="CheckForUpdatesButton_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="8,0"
                      AllowDrop="True" DragOver="BulbList_DragOver">
            <ItemsControl x:Name="BulbList" Margin="8,0,8,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- El Border entero (incluida la manija) queda SIEMPRE habilitado para poder
                             arrastrar/soltar incluso con el foco desconectado; solo el contenido interactivo
                             (StackPanel de la derecha) se deshabilita y grisa según IsOnline. -->
                        <Border x:Name="BulbCard" Background="{StaticResource CardBrush}" CornerRadius="10"
                                Padding="14" Margin="0,0,0,10" AllowDrop="True" Drop="BulbCard_Drop">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Opacity" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                            <Setter Property="Opacity" Value="0.45"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="20" Background="Transparent"
                                        Cursor="SizeAll" Margin="0,0,8,0" VerticalAlignment="Stretch"
                                        PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                        PreviewMouseMove="DragHandle_PreviewMouseMove"
                                        ToolTip="Arrastrar para reordenar">
                                    <UniformGrid Columns="2" Rows="3" Width="8" Height="14"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  IsHitTestVisible="False">
                                        <Ellipse Width="3" Height="3" Fill="#6A6A6E" Margin="1"/>
                                        <Ellipse Width="3" Height="3" Fill="#6A6A6E" Margin="1"/>
                                        <Ellipse Width="3" Height="3" Fill="#6A6A6E" Margin="1"/>
                                        <Ellipse Width="3" Height="3" Fill="#6A6A6E" Margin="1"/>
                                        <Ellipse Width="3" Height="3" Fill="#6A6A6E" Margin="1"/>
                                        <Ellipse Width="3" Height="3" Fill="#6A6A6E" Margin="1"/>
                                    </UniformGrid>
                                </Border>

                                <StackPanel Grid.Column="1" IsEnabled="{Binding IsOnline}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0" IsChecked="{Binding IsFavorite}"
                                                      Style="{StaticResource FavoriteStarStyle}"
                                                      Click="FavoriteToggle_Click"
                                                      ToolTip="Marcar como favorito (controlado desde la barra de tareas)"/>
                                        <TextBox x:Name="NameTextBox" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent" BorderThickness="0" Foreground="#F5F5F5"
                                                 FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                                                 Padding="0" Margin="4,0,0,0" LostFocus="NameTextBox_LostFocus"/>
                                        <Button Grid.Column="2" Content="&#9998;" Style="{StaticResource IconGhostButtonStyle}"
                                                Click="EditName_Click" ToolTip="Renombrar"/>
                                        <ToggleButton Grid.Column="3" IsChecked="{Binding IsOn}"
                                                      Style="{StaticResource SwitchToggleStyle}"
                                                      Click="PowerToggle_Click"/>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,12">
                                        <TextBlock Text="{Binding Ip}" FontSize="11" Opacity="0.45"/>
                                        <TextBlock Text=" · desconectado" FontSize="11" Foreground="#FF6B6B">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsOnline}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Grid.Column="0" Minimum="10" Maximum="100" Value="{Binding Brightness}"
                                                Margin="0,0,8,0" VerticalAlignment="Center"
                                                Style="{StaticResource AccentSliderStyle}"
                                                ValueChanged="BrightnessSlider_ValueChanged"
                                                PreviewMouseLeftButtonDown="BrightnessSlider_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="BrightnessSlider_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="BrightnessSlider_PreviewMouseLeftButtonUp"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Brightness, StringFormat={}{0:0}%}"
                                                   Width="38" Opacity="0.7" FontSize="12" VerticalAlignment="Center"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal">
                                        <Button Tag="TEMP:2700" Background="#FFD9A6" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click" ToolTip="Blanco cálido (brillo máximo real)"/>
                                        <Button Tag="TEMP:6500" Background="#EAF4FF" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click" ToolTip="Blanco frío (brillo máximo real)"/>
                                        <Button Tag="#FF6B6B" Background="#FF6B6B" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                        <Button Tag="#FFA500" Background="#FFA500" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                        <Button Tag="#FFD93D" Background="#FFD93D" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                        <Button Tag="#6BCB77" Background="#6BCB77" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                        <Button Tag="#4D96FF" Background="#4D96FF" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                        <Button Tag="#9B5DE5" Background="#9B5DE5" Style="{StaticResource SwatchButtonStyle}" Click="ColorSwatch_Click"/>
                                        <Button x:Name="MoreColorsButton" Content="&#8230;" Style="{StaticResource SwatchMoreButtonStyle}" Click="CustomColor_Click"/>

                                        <Popup x:Name="ColorPickerPopup" PlacementTarget="{Binding ElementName=MoreColorsButton}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                            <Border Background="#242424" CornerRadius="12" Padding="12"
                                                    BorderBrush="#3A3A3A" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Arriba = más brillo (mezcla con blanco) · Abajo = color más puro"
                                                               FontSize="10" Opacity="0.6" Width="240" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                                    <Canvas x:Name="ColorPickerCanvas" Width="240" Height="140" ClipToBounds="True"
                                                            Background="Transparent" Cursor="Cross"
                                                            MouseLeftButtonDown="ColorPickerCanvas_MouseLeftButtonDown"
                                                            MouseMove="ColorPickerCanvas_MouseMove"
                                                            MouseLeftButtonUp="ColorPickerCanvas_MouseLeftButtonUp">
                                                        <Rectangle Width="240" Height="140" RadiusX="8" RadiusY="8">
                                                            <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#FF0000" Offset="0"/>
                                                                    <GradientStop Color="#FFFF00" Offset="0.17"/>
                                                                    <GradientStop Color="#00FF00" Offset="0.33"/>
                                                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                                                    <GradientStop Color="#0000FF" Offset="0.67"/>
                                                                    <GradientStop Color="#FF00FF" Offset="0.83"/>
                                                                    <GradientStop Color="#FF0000" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                        <Rectangle Width="240" Height="140" RadiusX="8" RadiusY="8" IsHitTestVisible="False">
                                                            <Rectangle.Fill>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                    <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                                                    <GradientStop Color="#00FFFFFF" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Rectangle.Fill>
                                                        </Rectangle>
                                                        <Ellipse x:Name="ColorPickerThumb" Width="18" Height="18"
                                                                 Stroke="Black" StrokeThickness="2" Fill="Transparent"
                                                                 IsHitTestVisible="False" Canvas.Left="0" Canvas.Top="0"/>
                                                    </Canvas>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="4" Margin="16,4,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" Grid.Column="0" Opacity="0.55" FontSize="12"
                       Text="Buscando bombillos en tu red..." TextWrapping="Wrap"/>
            <TextBlock x:Name="VersionText" Grid.Column="1" Opacity="0.35" FontSize="11"
                       VerticalAlignment="Bottom" Margin="8,0,0,0"/>
        </Grid>
    </Grid>
</Window>
